# Canonical app URL for email/payment redirects. Blank = use window.location.origin.
VITE_SITE_URL=https://irookee.com

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# PostHog product analytics (frontend). Get the project API key from
# PostHog -> Project Settings. Leave blank to disable analytics.
VITE_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave blank to disable GA;
# keep it blank locally so development traffic stays out of the real property.
VITE_GA_MEASUREMENT_ID=
